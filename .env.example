#PostgreSQL Database Configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

#pgAdmin Configuration
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

#Database connection
DATABASE_URL=postgresql+asyncpg://postgres_user:postgres_password@localhost:5432/postgres_db

# JWT configuration
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# CORS
CORS_ORIGINS="*"